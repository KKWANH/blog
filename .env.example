# GitHub App OAuth client credentials. Do not use the numeric App ID.
# Install the app only on KKWANH/blog with Contents: read/write.
GITHUB_ID=
GITHUB_SECRET=

# Generate a random secret locally; do not commit actual values.
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.kwanho.dev

# Durable private storage is required in production for revocable GitHub owner
# sessions as well as private statistics. Use an HTTPS Upstash REST endpoint.
ANALYTICS_REDIS_REST_URL=
ANALYTICS_REDIS_REST_TOKEN=

# Optional password-protected statistics dashboard.
# These are a scrypt verifier and an independent random 32-byte base64url key,
# never a plaintext password. See docs/admin-statistics.md.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_ORIGIN=https://www.kwanho.dev
ANALYTICS_ENABLED=0

# Local file editing is enabled by npm run dev:edit.
# Production never falls back to a writable local file.

# Optional private design folder for /studio/ in local development.
# DEV_STUDIO_DIR=C:/Projects/career-refresh-2026-10/design
