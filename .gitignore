# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local tooling (Claude Code launch config, etc.)
.claude/
.local/
.private/

# typescript
*.tsbuildinfo
next-env.d.ts
contents/travel/*.tmp
contents/about/*.tmp
contents/photography/*.tmp
contents/photography/*.lock
/public/maplibre-worker.mjs
/public/maplibre-LICENSE.txt

# career-refresh heavy binaries & media
career-refresh-2026-10/**/*.png
career-refresh-2026-10/**/*.jpg
career-refresh-2026-10/**/*.jpeg
career-refresh-2026-10/**/*.gif
career-refresh-2026-10/**/*.webp
career-refresh-2026-10/**/*.pdf
career-refresh-2026-10/**/*.docx
career-refresh-2026-10/**/*.mp4
career-refresh-2026-10/**/*.zip
career-refresh-2026-10/**/*.exe
career-refresh-2026-10/**/*.pyd
career-refresh-2026-10/tools/node-*
career-refresh-2026-10/tools/python/
career-refresh-2026-10/tools/font-compress/
career-refresh-2026-10/screenshots/
career-refresh-2026-10/source/asset-archive-*/
career-refresh-2026-10/**/__pycache__/
career-refresh-2026-10/**/*.pyc

# travel photo originals (may carry GPS); publish only the WebP derivatives
contents/photography/travel/**/*.jpg
contents/photography/travel/**/*.jpeg
contents/photography/travel/**/*.JPG
contents/photography/travel/**/*.JPEG
contents/photography/travel/**/*.png
contents/photography/travel/**/*.PNG
contents/photography/travel/**/*.heic
contents/photography/travel/**/*.HEIC
contents/photography/travel/**/*.heif
contents/photography/travel/**/*.webp
contents/photography/travel/**/*.avif
contents/photography/travel/**/*.tif
contents/photography/travel/**/*.tiff
